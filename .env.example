# Vercel: connect a remote libSQL database (Turso libSQL).
# Set both values in Vercel Environment Variables, then redeploy.
# URL example: libsql://your-database.turso.io
# Empty values keep local development offline.
# Keep these server-only: never prefix them with NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local-only optional path; leave remote variables unset for offline local play.
# GAME_SQLITE_PATH=.data/rooms.sqlite
